#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

fail() {
  printf 'pre-commit: FAILED at %s\n' "$1" >&2
  exit 1
}

pin() {
  local wanted="$1" line key value
  [[ -r .github/tidy.env ]] || fail 'tidy pin'
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      ''|\#*) continue ;;
    esac
    key="${line%%=*}"
    if [[ "$key" == "$wanted" ]]; then
      value="${line#*=}"
      value="${value%$'\r'}"
      printf '%s' "$value"
      return 0
    fi
  done < .github/tidy.env
  printf 'pre-commit: tidy: missing pin %s in .github/tidy.env\n' "$wanted" >&2
  fail 'tidy pin'
}

hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    printf 'pre-commit: tidy: no SHA-256 tool available\n' >&2
    fail 'tidy checksum tool'
  fi
}

staged_list="$(mktemp)"
if ! git diff --cached --name-only --diff-filter=ACMR -z > "$staged_list"; then
  rm -f "$staged_list"
  fail 'staged file list'
fi
staged=()
while IFS= read -r -d '' file; do
  staged+=("$file")
done < "$staged_list"
rm -f "$staged_list"

if ((${#staged[@]} > 0)); then
  for file in "${staged[@]}"; do
    if ! git diff --quiet -- "$file"; then
      printf 'pre-commit: partially staged: %s; stage it fully or stash\n' "$file" >&2
      exit 1
    fi
  done
fi
printf 'pre-commit: partial-staging check: %s staged file(s) clean\n' "${#staged[@]}"

rust_files=()
other_files=()
if ((${#staged[@]} > 0)); then
  for file in "${staged[@]}"; do
    case "$file" in
      *.rs) rust_files+=("$file") ;;
      *) other_files+=("$file") ;;
    esac
  done
fi

if ((${#rust_files[@]} > 0)); then
  printf 'pre-commit: rustfmt: formatting %s staged Rust file(s)\n' "${#rust_files[@]}"
  for file in "${rust_files[@]}"; do
    if ! rustfmt --edition 2024 --config skip_children=true "./$file"; then
      fail 'rustfmt'
    fi
    git add -- "$file"
  done
fi

if ((${#other_files[@]} > 0)); then
  TIDY_VERSION="$(pin TIDY_VERSION)"
  release_base="$(pin TIDY_RELEASE_BASE)"
  platform="${TIDY_PLATFORM:-$(uname -s)-$(uname -m)}"
  case "$platform" in
    Darwin-arm64)
      asset="$(pin TIDY_DARWIN_ASSET)"
      tidy_sha="$(pin TIDY_DARWIN_SHA256)"
      ;;
    Darwin-x86_64)
      asset="$(pin TIDY_DARWIN_X86_ASSET)"
      tidy_sha="$(pin TIDY_DARWIN_X86_SHA256)"
      ;;
    Linux-x86_64)
      asset="$(pin TIDY_LINUX_ASSET)"
      tidy_sha="$(pin TIDY_LINUX_SHA256)"
      ;;
    *)
      printf 'pre-commit: tidy: unsupported platform %s\n' "$platform" >&2
      fail 'tidy platform'
      ;;
  esac
  if [[ ! "$tidy_sha" =~ ^[0-9a-f]{64}$ ]]; then
    fail 'tidy pin'
  fi
  tidy_url="$release_base/${TIDY_VERSION}/$asset"
  cache_dir="${TIDY_CACHE_ROOT:-$HOME/.cache/wrkhse}/tidy-${tidy_sha}"
  archive="$cache_dir/tidy.tar.gz"
  tidy_bin="$cache_dir/tidy"
  mkdir -p "$cache_dir"
  if [[ ! -f "$archive" ]]; then
    printf 'pre-commit: tidy: downloading %s\n' "$tidy_url"
    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' EXIT
    if ! curl -fsSL --proto '=https' --proto-redir '=https' --connect-timeout 10 --max-time 180 "$tidy_url" -o "$tmp_dir/tidy.tar.gz"; then
      fail 'tidy download'
    fi
    downloaded="$(hash_file "$tmp_dir/tidy.tar.gz")"
    if [[ "$downloaded" != "$tidy_sha" ]]; then
      printf 'pre-commit: tidy checksum mismatch: expected %s, got %s\n' "$tidy_sha" "$downloaded" >&2
      rm -f "$archive"
      fail 'tidy checksum'
    fi
    if ! mv "$tmp_dir/tidy.tar.gz" "$archive"; then
      fail 'tidy cache'
    fi
    rm -rf "$tmp_dir"
    trap - EXIT
  fi
  cached="$(hash_file "$archive")"
  if [[ "$cached" != "$tidy_sha" ]]; then
    printf 'pre-commit: tidy checksum mismatch: expected %s, got %s\n' "$tidy_sha" "$cached" >&2
    rm -f "$archive"
    fail 'tidy checksum'
  fi
  printf 'pre-commit: tidy: verified checksum %s\n' "$tidy_sha"
  extract_dir="$(mktemp -d)"
  trap 'rm -rf "$extract_dir"' EXIT
  if ! tar -xzf "$archive" -C "$extract_dir" tidy; then
    fail 'tidy extract'
  fi
  if ! cmp -s "$extract_dir/tidy" "$tidy_bin"; then
    if ! mv "$extract_dir/tidy" "$cache_dir/tidy.tmp"; then
      fail 'tidy install'
    fi
    chmod +x "$cache_dir/tidy.tmp"
    if ! mv "$cache_dir/tidy.tmp" "$tidy_bin"; then
      fail 'tidy install'
    fi
  fi
  chmod +x "$tidy_bin"
  rm -rf "$extract_dir"
  trap - EXIT
  printf 'pre-commit: tidy: cached binary %s\n' "$tidy_bin"
  printf 'pre-commit: tidy: formatting %s staged file(s)\n' "${#other_files[@]}"
  for file in "${other_files[@]}"; do
    if ! "$tidy_bin" up --skip-unknown "./$file"; then
      fail 'tidy format'
    fi
    git add -- "$file"
  done
fi

printf 'pre-commit: all checks passed\n'
